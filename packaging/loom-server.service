# Sample systemd unit for the standalone `loom-server` backend.
#
# Install it as `/etc/systemd/system/loom-server.service`, adjust `ExecStart` to
# the path the unpacked binary lives at, then:
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now loom-server
#
# The unit runs as a dedicated non-root user. Create that account first:
#
#   sudo useradd --system --home-dir /var/lib/loom --create-home \
#     --shell /usr/sbin/nologin loom
#
# `ExecStart` needs no hand-made token file. With `LOOM_STATE_DIR=/var/lib/loom`
# the server keeps its instance directory at `/var/lib/loom/loom/loom-server`
# and generates a `loom-<uuid>` bearer token at
# `/var/lib/loom/loom/loom-server/token` on first start, written with mode 0600
# and reused on every later start. The path is always logged and the value is
# printed only to a terminal, so read the token from the file:
#
#   sudo cat /var/lib/loom/loom/loom-server/token
#
# Add `--token-file /path/to/token` when the token must live elsewhere. A file
# is preferred over `--token`, whose value any local user could read from
# `/proc`.
#
# This unit serves plain `ws://` on loopback. For a remote deployment, add
# `--tls-cert /path/to/cert.pem --tls-key /path/to/key.pem` to `ExecStart` and
# bind a non-loopback address; the server refuses that bind without TLS unless
# `--allow-insecure-remote` opts in to sending the token and all traffic in the
# clear. The TLS key must be readable by the `loom` user, so give it that
# ownership rather than leaving it root-only.
[Unit]
Description=Loom standalone backend
Documentation=https://github.com/bearmuckle/loom
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=loom
Group=loom
ExecStart=/usr/local/bin/loom-server --bind 127.0.0.1:8765 \
  --instance-name loom-server
Restart=on-failure
RestartSec=5
StateDirectory=loom
WorkingDirectory=/var/lib/loom
Environment=RUST_LOG=loom_server=info
Environment=LOOM_STATE_DIR=/var/lib/loom

[Install]
WantedBy=multi-user.target
